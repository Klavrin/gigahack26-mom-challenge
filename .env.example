# Copy to .env to override defaults. Each machine keeps its own .env.
# PowerShell: Copy-Item .env.example .env

# ---- Laptop (docker-compose.yml) ----
# 1 = canned transcript + minutes, no model calls. Set 0 once the GPU node
# answers: sh scripts/smoke-gpu-node.sh <GPU_NODE_IP>
MOCK_MODELS=1
ASR_URL=http://<GPU_NODE_IP>:8000
OLLAMA_URL=http://<GPU_NODE_IP>:11434
CORRECT_TRANSCRIPT=0
KEEP_AUDIO=0

# ---- One machine (docker-compose.yml + docker-compose.gpu.yml, same host) ----
# MOCK_MODELS=0
# ASR_URL=http://asr:8000
# OLLAMA_URL=http://ollama:11434
# ASR_PORT=8001

# ---- Both ----
LLM_MODEL=qwen3:8b
ASR_MODE=segment
# whisper | nemotron (nemotron needs the nemo container: --profile nemo)
ASR_BACKEND=whisper
NEMOTRON_URL=http://nemo:8001
# Speaker diarization (Sortformer in the nemo container). Empty = off.
DIARIZATION_URL=

# ---- GPU node (docker-compose.gpu.yml) ----
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8_float16
# Which models the nemo container loads: asr,diar | asr | diar
NEMO_LOAD=asr,diar
# Set to 1 after the first run: models load from disk only, no network.
OFFLINE=0

# ---- n8n / Mailpit ----
# Keep this stable after the n8n_data volume is created. Changing it later
# prevents n8n from decrypting saved credentials. Replace it before first use
# outside the local demo, then retain that value for the life of the volume.
N8N_ENCRYPTION_KEY=local-demo-key-change-me
# Set to this host's LAN/Tailscale IPv4 only when the backend runs on another device.
N8N_BIND_ADDRESS=127.0.0.1
MAILPIT_BIND_ADDRESS=127.0.0.1
# Backend in this Compose network: http://n8n:5678/webhook/mom
N8N_WEBHOOK_URL=http://n8n:5678/webhook/mom
