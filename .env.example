# Copy to .env to override defaults.
LLM_MODEL=qwen2.5:7b-instruct
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8_float16
ASR_MODE=segment
CORRECT_TRANSCRIPT=0
KEEP_AUDIO=0
# Set to 1 after the first run: models load from disk only, no network.
OFFLINE=0
# Keep this stable after the n8n_data volume is created. Changing it later
# prevents n8n from decrypting saved credentials. Replace it before first use
# outside the local demo, then retain that value for the life of the volume.
N8N_ENCRYPTION_KEY=local-demo-key-change-me

# Automation runs without GPU on macOS, Linux/AMD, or Windows Docker Desktop.
# Set to this host's Tailscale IPv4 only when backend runs on another device.
N8N_BIND_ADDRESS=127.0.0.1
MAILPIT_BIND_ADDRESS=127.0.0.1
# Backend in this Compose network: http://n8n:5678/webhook/mom
# Native/remote backend: http://<coordinator-tailscale-ip>:5678/webhook/mom
N8N_WEBHOOK_URL=http://n8n:5678/webhook/mom
# Handoff settings for the new coordinator (NeMo/Nemotron clients pending).
# Qwen is served by native Ollama on the AMD machine; no NVIDIA dependency.
QWEN_URL=http://host.docker.internal:11434
NEMOTRON_URL=http://nemotron-worker:8001
NEMO_URL=http://nemo-worker:8002
