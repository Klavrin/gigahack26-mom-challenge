# Copy to .env to override defaults.
LLM_MODEL=qwen2.5:7b-instruct
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8_float16
ASR_MODE=segment
CORRECT_TRANSCRIPT=0
KEEP_AUDIO=0
# Set to 1 after the first run: models load from disk only, no network.
OFFLINE=0
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
