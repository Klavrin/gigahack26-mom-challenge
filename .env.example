# Copy to .env to override defaults.
LLM_MODEL=qwen2.5:7b-instruct
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8_float16
ASR_MODE=segment
CORRECT_TRANSCRIPT=0
KEEP_AUDIO=0
# Set to 1 after the first run: models load from disk only, no network.
OFFLINE=0
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- NVIDIA speech models (docker compose --profile nemo up -d) ---
# whisper | nemotron
ASR_BACKEND=whisper
# Local container by default. During development it can point at a teammate's
# machine on the team network (e.g. http://100.x.x.30:8001) - never a cloud URL.
NEMOTRON_URL=http://nemo:8001
# Empty = no diarization. http://nemo:8001 = Sortformer speaker labels.
DIARIZATION_URL=
# Which models the nemo container loads: asr,diar | asr | diar
NEMO_LOAD=asr,diar
