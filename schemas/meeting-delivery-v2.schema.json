{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2"
      ]
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
    },
    "state": {
      "type": "object",
      "properties": {
        "meeting": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "type": {
              "type": "string",
              "enum": [
                "medical",
                "executive",
                "administrative"
              ]
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "ended_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "title",
            "type",
            "started_at",
            "ended_at"
          ],
          "additionalProperties": false
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 500
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 500
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 500
        },
        "action_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 10000
              },
              "deadline": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 10000
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "in_progress",
                  "done",
                  "cancelled"
                ]
              }
            },
            "required": [
              "description",
              "owner",
              "deadline",
              "status"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 500
        },
        "important_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "maxItems": 500
        }
      },
      "required": [
        "meeting",
        "participants",
        "topics",
        "decisions",
        "action_items",
        "open_questions",
        "important_notes"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "approved_by",
        "approved_at"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}\\.(pdf|docx)$"
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ]
          },
          "data_base64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 6990508,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "filename",
          "mime_type",
          "data_base64"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "state",
    "approval",
    "documents"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved meeting delivery v2",
  "description": "Final approved snapshot; transcript remains in backend. Maximum total decoded documents: 5 MiB. Approval must follow meeting end."
}
